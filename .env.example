# ============ 复制本文件为 .env 并填入真实 Key ============

# DeepSeek 对话模型（必填）
# 申请地址：https://platform.deepseek.com
DEEPSEEK_API_KEY=

# 阿里云百炼向量化模型（必填，向量化仍使用 DashScope）
# 申请地址：https://bailian.console.aliyun.com
DASHSCOPE_API_KEY=

# HuggingFace 镜像（可选，重排器等模型下载时使用）
HF_ENDPOINT=https://hf-mirror.com

# 重排器开关（可选，默认 true）
# 低配服务器（2G 内存）设为 false 可跳过重排、省内存
ENABLE_RERANKER=true
